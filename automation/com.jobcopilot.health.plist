<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jobcopilot.health</string>
    <key>ProgramArguments</key>
    <array>
        <string>/path/to/job-copilot/.venv/bin/python3</string>
        <string>/path/to/job-copilot/tools/health_check.py</string>
    </array>
    <key>StartInterval</key>
    <integer>7200</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/path/to/job-copilot/health_check.log</string>
    <key>StandardErrorPath</key>
    <string>/path/to/job-copilot/health_check.log</string>
</dict>
</plist>
